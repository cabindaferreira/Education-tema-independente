modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
NEWSLETTER_FROM_EMAIL = "academia@procenter.co.ao"
ACADEMY_OWNER_EMAIL = "dti.procenter@gmail.com"

[objectStorage]
defaultBucketID = "replit-objstore-b2bcbec6-4121-453a-a920-c74b0c60e174"
